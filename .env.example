# ─── Обязательное ─────────────────────────────────────────────────────────────

# Ключ Clinic Cards (Settings → Other → Clinic Settings → API key).
# Пусто → демо-режим на мок-данных (без обращений к сети).
CLINIC_CARDS_API_KEY=

# Supabase / Postgres — pooled connection string, например:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Пусто → in-memory (локально работает без БД, позиции не сохраняются).
DATABASE_URL=

# ─── Доступ и роли ────────────────────────────────────────────────────────────

# Bootstrap-администратор: создаётся в таблице users при первом запуске, если
# она пустая. Дальше аккаунты заводятся в приложении (страница «Користувачі»).
# ОБЯЗАТЕЛЬНО смените пароль в проде.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Секрет для подписи токенов авторизации (HMAC). Пусто → выводится из
# ADMIN_USER/ADMIN_PASSWORD (ок для одиночного хоста; для прода задайте свой,
# длинную случайную строку — тогда токены не зависят от пароля админа).
# AUTH_SECRET=

# ─── Настройка воронки под клинику ────────────────────────────────────────────

# Статусы Clinic Cards, которые считаются «закрыт/архив» (скрыть с борда).
CLINIC_CARDS_CLOSED_STATUSES=Выполненный,Отказался

# ─── Необязательные override (у всех есть разумные значения по умолчанию) ──────
# CLINIC_CARDS_BASE_URL=https://cliniccards.com/api
# Ссылка на профиль пациента в веб-приложении CC ({id} = patient_id).
# По умолчанию — тот же хост, что у BASE_URL, без /api: .../patients/{id}
# CLINIC_CARDS_PATIENT_URL=https://cliniccards.com/patients/{id}
# CLINIC_CARDS_PLANS_SINCE=2015-01-01
# CC_CACHE_TTL_SECONDS=180      # TTL кэша выгрузки CC (лимит API 60/мин)
# WINDOW_DAYS=30                # окно показа пациента от даты заявки
# STUCK_DAYS=3                  # без движения N дней → «Потребують уваги»
# HOT_VISIT_DAYS=1             # «Гарячі»: визит в пределах N дней
# CONVERSION_WINDOW_DAYS=30    # окно расчёта конверсии
# VISITS_BACK_DAYS=60          # диапазон визитов для «Коментар»
# VISITS_FWD_DAYS=120
# PORT=8787                    # для одиночного Node-хоста

# ─── План лечения (согласование ответственными) ───────────────────────────────
# PLAN_SLA_HOURS=48            # срок на составление плана (норматив)
# POSTPONE_FOLLOWUP_HOURS=24   # через сколько часов после «отложить» дёргать всех
# Лестница напоминаний врачу — доли от срока (срок = min(48ч, визит)):
# PLAN_REMIND_FRACTIONS=0.33,0.5   # на ⅓ и ½ срока
# VISIT_SOON_HOURS=4           # визит ближе этого без плана → срочно главврачу
# Тихие часы (по таймзоне клиники): мягкие напоминания копятся до утра.
# QUIET_HOURS_START=21
# QUIET_HOURS_END=9
# CLINIC_TZ=Europe/Kyiv        # таймзона для тихих часов и утреннего дайджеста

# ─── Telegram-бот согласования плана ──────────────────────────────────────────
# Сотрудники регистрируются в боте: /start → пишут «Имя, должность». Бот шлёт им
# в личку план с кнопками «Готово»/«Отложить»; подтверждение и комментарий —
# прямо в боте. Токен бота — от @BotFather.
TELEGRAM_BOT_TOKEN=
# NOTIFY_DRY_RUN=false        # true → внешние отправки отключены (только лог)
# Роль сотрудник выбирает кнопкой на /start: kerivnyk / head_doctor / doctor.
# Лікарі (doctor) — ответственные за план; кому слать итог — задаётся по роли:
# PLAN_READY_NOTIFY_ROLE=head_doctor   # кому «план готов»
# PLAN_ISSUE_NOTIFY_ROLE=head_doctor   # кого тегать «план не готов»

# ─── Деплой на Vercel (бот через webhook) ─────────────────────────────────────
# На Vercel long-polling не работает — бот принимает апдейты через webhook.
# Что задать в Vercel → Settings → Environment Variables:
#   TELEGRAM_BOT_TOKEN       — токен от @BotFather (обязательно)
#   DATABASE_URL             — Postgres/Supabase (обязательно! состояние диалога
#                              хранится в БД; без неё на serverless всё потеряется)
#   TELEGRAM_WEBHOOK_SECRET  — любая случайная строка (защита вебхука)
#   CRON_SECRET              — любая случайная строка (защита cron-напоминаний)
#   ADMIN_USER / ADMIN_PASSWORD / AUTH_SECRET — как обычно
# VERCEL=1 выставляется автоматически → режим webhook включается сам.
# После первого деплоя ОДИН раз открой в браузере, чтобы привязать вебхук:
#   https://<твой-домен>.vercel.app/api/telegram/setup?secret=<TELEGRAM_WEBHOOK_SECRET>
# Напоминания (24ч/4ч/просрочка) шлёт Vercel Cron → /api/cron/plan-sweep
# (расписание в vercel.json; на плане Hobby cron срабатывает раз в сутки).
# TELEGRAM_WEBHOOK=1          # включить webhook-режим вручную (не на Vercel)
# PUBLIC_URL=https://your-domain  # если авто-URL не подходит
# Бот работает в режиме long-polling на постоянном хосте (npm start / VPS /
# Railway). На Vercel (serverless) нужен webhook — отдельная доработка.
